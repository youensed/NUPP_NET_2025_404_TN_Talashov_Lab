@model IEnumerable<PetStore.MVC.Models.CustomerViewModel>

@{
    ViewData["Title"] = "Клієнти";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@ViewData["Title"]</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Додати клієнта
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Ім'я</th>
                        <th>Вік</th>
                        <th>Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td>@customer.Name</td>
                            <td>@customer.Age років</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i> Деталі
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil"></i> Редагувати
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@customer.Id" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Видалити
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Немає клієнтів для відображення. <a asp-action="Create">Додайте першого!</a>
        </div>
    }
</div>

