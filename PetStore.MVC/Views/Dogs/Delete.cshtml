@model PetStore.MVC.Models.DogViewModel

@{
    ViewData["Title"] = "Видалити собаку";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>
    <hr />

    <div class="alert alert-warning">
        <h4>Ви впевнені, що хочете видалити цього собаку?</h4>
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Ім'я</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Вік</dt>
                <dd class="col-sm-9">@Model.Age років</dd>

                <dt class="col-sm-3">Порода</dt>
                <dd class="col-sm-9">@Model.Breed</dd>

                <dt class="col-sm-3">Дресирований</dt>
                <dd class="col-sm-9">
                    @if (Model.IsTrained)
                    {
                        <span class="badge bg-success">Так</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Ні</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete" method="post" class="mt-3">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash"></i> Видалити
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-x-circle"></i> Скасувати
        </a>
    </form>
</div>

