@model PetStore.MVC.Models.DogViewModel

@{
    ViewData["Title"] = "Деталі собаки";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>
    <hr />

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Ім'я</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Вік</dt>
                <dd class="col-sm-9">@Model.Age років</dd>

                <dt class="col-sm-3">Порода</dt>
                <dd class="col-sm-9">@Model.Breed</dd>

                <dt class="col-sm-3">Дресирований</dt>
                <dd class="col-sm-9">
                    @if (Model.IsTrained)
                    {
                        <span class="badge bg-success">Так</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Ні</span>
                    }
                </dd>

                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9"><code>@Model.Id</code></dd>
            </dl>
        </div>
        <div class="card-footer">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="bi bi-pencil"></i> Редагувати
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Назад до списку
            </a>
        </div>
    </div>
</div>

