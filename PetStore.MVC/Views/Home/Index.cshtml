@{
    ViewData["Title"] = "Головна";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-3 fw-bold text-primary">🐾 PetStore MVC</h1>
        <p class="lead text-muted">Система управління магазином домашніх тварин</p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-primary">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-dog" style="font-size: 4rem; color: #0d6efd;"></i>
                    </div>
                    <h3 class="card-title">Собаки</h3>
                    <p class="card-text">Керуйте інформацією про собак у магазині</p>
                    <a asp-controller="Dogs" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-arrow-right-circle"></i> Переглянути
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-success">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-cat" style="font-size: 4rem; color: #198754;"></i>
                    </div>
                    <h3 class="card-title">Коти</h3>
                    <p class="card-text">Керуйте інформацією про котів у магазині</p>
                    <a asp-controller="Cats" asp-action="Index" class="btn btn-success">
                        <i class="bi bi-arrow-right-circle"></i> Переглянути
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-warning">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-people" style="font-size: 4rem; color: #ffc107;"></i>
                    </div>
                    <h3 class="card-title">Клієнти</h3>
                    <p class="card-text">Керуйте базою даних клієнтів</p>
                    <a asp-controller="Customers" asp-action="Index" class="btn btn-warning">
                        <i class="bi bi-arrow-right-circle"></i> Переглянути
                    </a>
                </div>
            </div>
        </div>
    </div>

   
</div>

